@import "art.wxss";
/* Guide layer. Class selectors only (component style isolation).
   Phases: p-receding -> p-cinema -> p-reveal -> p-chat -> p-leaving.
   Durations mirror TIMING in index.js: 700 / 3400 / 900 / 520 ms. */
.g-layer { position: fixed; left: 0; top: 0; right: 0; bottom: 0; z-index: 900; overflow: hidden; color: #243f3b; font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Noto Sans SC", sans-serif; font-size: 25rpx; line-height: 1.6; }
.g-veil { position: absolute; left: 0; top: 0; right: 0; bottom: 0; background: linear-gradient(180deg, #f5f1e8 0%, #f7f3ea 52%, #f1ede1 100%); }
.g-press { opacity: .62; }

/* ---------- Phase A: the source page recedes under a paper veil ---------- */
.p-receding .g-veil { animation: g-veil .7s ease both; }
.is-short.p-receding .g-veil { animation-duration: .5s; }
.g-ripple { position: absolute; left: 50%; bottom: calc(env(safe-area-inset-bottom) + 22rpx); width: 120rpx; height: 120rpx; margin-left: -60rpx; border-radius: 50%; border: 2rpx solid #ad8849; opacity: 0; }
.p-receding .g-ripple { animation: g-ripple .7s ease-out both; }
@keyframes g-veil { 0% { opacity: 0; } 42% { opacity: .38; } 100% { opacity: 1; } }
@keyframes g-ripple { 0% { opacity: .75; transform: scale(1); } 100% { opacity: 0; transform: scale(15); } }

/* ---------- Phase B: cinematic ---------- */
.g-hills { position: absolute; left: 0; right: 0; bottom: 0; height: 380rpx; opacity: .5; transition: opacity .8s ease; pointer-events: none; }
.g-hill { position: absolute; left: 0; right: 0; bottom: 0; height: 380rpx; background-size: 100% 100%; background-repeat: no-repeat; }
.p-receding .g-hills { opacity: 0; transition: none; }
.p-cinema .g-hills { opacity: 1; }
.p-cinema .g-hill-far { animation: g-hill 1.1s cubic-bezier(.2, .7, .2, 1) both; }
.p-cinema .g-hill-near { animation: g-hill 1.1s cubic-bezier(.2, .7, .2, 1) .12s both; }
@keyframes g-hill { 0% { opacity: 0; transform: translateY(70rpx); } 100% { opacity: 1; transform: translateY(0); } }

.g-stage { position: absolute; left: 0; top: 11vh; width: 750rpx; height: 760rpx; pointer-events: none; }
.p-receding .g-stage, .p-receding .g-title { opacity: 0; }
.p-chat .g-stage, .p-leaving .g-stage, .is-short .g-stage, .is-skipped .g-stage { display: none; }
.p-reveal .g-stage { animation: g-stage-out .42s ease both; }
@keyframes g-stage-out { 0% { opacity: 1; transform: translateY(0); } 100% { opacity: 0; transform: translateY(-28rpx); } }

/* B1: one line of water runs down the paper */
.g-water { position: absolute; left: 373rpx; top: -11vh; width: 4rpx; height: calc(11vh + 298rpx); border-radius: 4rpx; background: linear-gradient(180deg, rgba(86, 117, 108, 0) 0%, #56756c 26%, #3f625a 100%); transform-origin: 50% 0; }
.p-cinema .g-water { animation: g-draw-y .6s cubic-bezier(.5, 0, .7, .6) both; }
.g-leaf { position: absolute; left: 380rpx; top: 250rpx; width: 30rpx; height: 16rpx; border-radius: 100% 0 100% 0; background: linear-gradient(120deg, #c9ae78, #ad8849); opacity: 0; }
.p-cinema .g-leaf { animation: g-leaf 1.6s cubic-bezier(.3, .1, .3, 1) both; }
@keyframes g-draw-y { 0% { transform: scaleY(0); } 100% { transform: scaleY(1); } }
@keyframes g-draw-x { 0% { transform: scaleX(0); } 100% { transform: scaleX(1); } }
@keyframes g-leaf { 0% { opacity: 0; transform: translate(-6rpx, -330rpx) rotate(-40deg); } 12% { opacity: 1; } 40% { opacity: 1; transform: translate(4rpx, -20rpx) rotate(18deg); } 62% { opacity: 1; transform: translate(70rpx, 10rpx) rotate(52deg); } 100% { opacity: 0; transform: translate(190rpx, -34rpx) rotate(96deg); } }

/* B2: the dividing stone, a ripple, four channels */
.g-stone { position: absolute; left: 347rpx; top: 294rpx; width: 56rpx; height: 32rpx; border-radius: 46% 54% 50% 50% / 60% 58% 42% 40%; background: linear-gradient(160deg, #3c5d56, #1f3733); box-shadow: 0 6rpx 14rpx rgba(36, 63, 59, .18); }
.p-cinema .g-stone { animation: g-stone .34s cubic-bezier(.3, 1.5, .5, 1) .46s both; }
@keyframes g-stone { 0% { opacity: 0; transform: scale(.3); } 100% { opacity: 1; transform: scale(1); } }
.g-ring { position: absolute; left: 335rpx; top: 280rpx; width: 80rpx; height: 60rpx; border-radius: 50%; border: 2rpx solid #ad8849; opacity: 0; }
.p-cinema .g-ring-1 { animation: g-ring .8s ease-out .6s both; }
.p-cinema .g-ring-2 { animation: g-ring .8s ease-out .82s both; }
@keyframes g-ring { 0% { opacity: 0; transform: scale(.7); } 12% { opacity: .7; } 100% { opacity: 0; transform: scale(2.6); } }

.g-ch-h, .g-ch-c, .g-ch-v { position: absolute; }
.g-ch-h { height: 4rpx; background: #4c6f67; border-radius: 4rpx; }
.g-ch-v { width: 4rpx; background: linear-gradient(180deg, #4c6f67, #6c8a80); border-radius: 4rpx; transform-origin: 50% 0; }
.g-ch-c { border: 0 solid #4c6f67; box-sizing: border-box; }
/* outer pair leaves the stone on the upper level */
.g-ch-1 .g-ch-h { left: 167rpx; top: 302rpx; width: 182rpx; transform-origin: 100% 50%; }
.g-ch-1 .g-ch-c { left: 139rpx; top: 302rpx; width: 30rpx; height: 30rpx; border-top-width: 4rpx; border-left-width: 4rpx; border-top-left-radius: 30rpx; }
.g-ch-1 .g-ch-v { left: 139rpx; top: 330rpx; height: 76rpx; }
.g-ch-4 .g-ch-h { left: 401rpx; top: 302rpx; width: 182rpx; transform-origin: 0 50%; }
.g-ch-4 .g-ch-c { left: 581rpx; top: 302rpx; width: 30rpx; height: 30rpx; border-top-width: 4rpx; border-right-width: 4rpx; border-top-right-radius: 30rpx; }
.g-ch-4 .g-ch-v { left: 607rpx; top: 330rpx; height: 76rpx; }
/* inner pair leaves on the lower level */
.g-ch-2 .g-ch-h { left: 317rpx; top: 318rpx; width: 34rpx; transform-origin: 100% 50%; }
.g-ch-2 .g-ch-c { left: 295rpx; top: 318rpx; width: 24rpx; height: 24rpx; border-top-width: 4rpx; border-left-width: 4rpx; border-top-left-radius: 24rpx; }
.g-ch-2 .g-ch-v { left: 295rpx; top: 340rpx; height: 66rpx; }
.g-ch-3 .g-ch-h { left: 399rpx; top: 318rpx; width: 34rpx; transform-origin: 0 50%; }
.g-ch-3 .g-ch-c { left: 431rpx; top: 318rpx; width: 24rpx; height: 24rpx; border-top-width: 4rpx; border-right-width: 4rpx; border-top-right-radius: 24rpx; }
.g-ch-3 .g-ch-v { left: 451rpx; top: 340rpx; height: 66rpx; }
.p-cinema .g-ch-1 .g-ch-h, .p-cinema .g-ch-4 .g-ch-h { animation: g-draw-x .26s linear .62s both; }
.p-cinema .g-ch-1 .g-ch-c, .p-cinema .g-ch-4 .g-ch-c { animation: g-pop .1s linear .88s both; }
.p-cinema .g-ch-1 .g-ch-v, .p-cinema .g-ch-4 .g-ch-v { animation: g-draw-y .2s ease-out .96s both; }
.p-cinema .g-ch-2 .g-ch-h, .p-cinema .g-ch-3 .g-ch-h { animation: g-draw-x .12s linear .62s both; }
.p-cinema .g-ch-2 .g-ch-c, .p-cinema .g-ch-3 .g-ch-c { animation: g-pop .1s linear .74s both; }
.p-cinema .g-ch-2 .g-ch-v, .p-cinema .g-ch-3 .g-ch-v { animation: g-draw-y .26s ease-out .82s both; }
@keyframes g-pop { 0% { opacity: 0; } 100% { opacity: 1; } }

/* four writing cells with the village motifs: tree, water, hall, book */
.g-cell { position: absolute; top: 410rpx; width: 124rpx; height: 124rpx; border: 1rpx solid rgba(173, 136, 73, .42); box-sizing: border-box; }
.g-cell-1 { left: 79rpx; } .g-cell-2 { left: 235rpx; } .g-cell-3 { left: 391rpx; } .g-cell-4 { left: 547rpx; }
.g-motif { position: absolute; left: 26rpx; top: 26rpx; width: 72rpx; height: 72rpx; background-size: 100% 100%; background-repeat: no-repeat; opacity: 0; }
.g-cell-tag { position: absolute; left: 0; right: 0; bottom: -40rpx; text-align: center; font-family: "STKaiti", "KaiTi", serif; font-size: 22rpx; color: #a88a52; letter-spacing: 2rpx; }
.p-cinema .g-cell { animation: g-cell .4s ease-out both; }
.p-cinema .g-cell-1 { animation-delay: .98s; } .p-cinema .g-cell-2 { animation-delay: 1.02s; } .p-cinema .g-cell-3 { animation-delay: 1.06s; } .p-cinema .g-cell-4 { animation-delay: 1.1s; }
.p-cinema .g-motif { animation: g-motif .78s ease both; }
.p-cinema .g-cell-1 .g-motif { animation-delay: .98s; } .p-cinema .g-cell-2 .g-motif { animation-delay: 1.2s; } .p-cinema .g-cell-3 .g-motif { animation-delay: 1.42s; } .p-cinema .g-cell-4 .g-motif { animation-delay: 1.64s; }
@keyframes g-cell { 0% { opacity: 0; transform: scale(.86); } 100% { opacity: 1; transform: scale(1); } }
@keyframes g-motif { 0% { opacity: 0; transform: translateY(-14rpx) scale(.8); } 38% { opacity: 1; transform: translateY(0) scale(1); } 62% { opacity: 1; transform: scale(1); } 100% { opacity: 0; transform: scale(1.5); } }

/* B3: the title soaks into the paper, one character per channel */
.g-title { position: absolute; left: 79rpx; top: calc(11vh + 410rpx); display: flex; transform-origin: 0 0; transition: transform .8s cubic-bezier(.65, 0, .2, 1); z-index: 3; pointer-events: none; }
.g-char { display: block; width: 124rpx; height: 124rpx; margin-right: 32rpx; text-align: center; font-family: "STKaiti", "KaiTi", serif; font-size: 102rpx; line-height: 124rpx; color: #243f3b; }
.p-cinema .g-char { animation: g-soak .58s cubic-bezier(.2, .7, .2, 1) both; }
.p-cinema .g-char-1 { animation-delay: 1.15s; } .p-cinema .g-char-2 { animation-delay: 1.37s; } .p-cinema .g-char-3 { animation-delay: 1.59s; } .p-cinema .g-char-4 { animation-delay: 1.81s; }
.is-short.p-cinema .g-char { animation-duration: .5s; }
.is-short.p-cinema .g-char-1 { animation-delay: .04s; } .is-short.p-cinema .g-char-2 { animation-delay: .12s; } .is-short.p-cinema .g-char-3 { animation-delay: .2s; } .is-short.p-cinema .g-char-4 { animation-delay: .28s; }
@keyframes g-soak { 0% { opacity: 0; filter: blur(16rpx); transform: translateY(14rpx) scale(1.2); } 55% { opacity: .9; filter: blur(3rpx); } 100% { opacity: 1; filter: blur(0); transform: translateY(0) scale(1); } }
/* header position of the same element: 46rpx characters at (116rpx, 30rpx) */
.p-reveal .g-title, .p-chat .g-title, .p-leaving .g-title { transform: translate(37rpx, calc(-11vh - 380rpx)) scale(.371); }
.is-short.p-reveal .g-title { transition-duration: .62s; }

/* B4: seal and one line of verse */
.g-seal { position: absolute; left: 612rpx; top: 596rpx; width: 78rpx; height: 78rpx; background: #ad8849; border-radius: 8rpx; display: flex; flex-direction: column; align-items: center; justify-content: center; transform: rotate(-4deg); box-shadow: 0 0 0 3rpx rgba(173, 136, 73, .25); }
.g-seal-text { display: block; font-family: "STKaiti", "KaiTi", serif; font-size: 25rpx; line-height: 1.2; color: #fff8e6; letter-spacing: 2rpx; }
.p-cinema .g-seal { animation: g-seal .4s cubic-bezier(.3, 1.4, .5, 1) 2.35s both; }
@keyframes g-seal { 0% { opacity: 0; transform: rotate(-14deg) scale(1.9); } 100% { opacity: 1; transform: rotate(-4deg) scale(1); } }
.g-sub { position: absolute; left: 60rpx; right: 150rpx; top: 610rpx; text-align: center; font-family: "STKaiti", "KaiTi", serif; font-size: 30rpx; letter-spacing: 5rpx; color: #6f7c6d; }
.p-cinema .g-sub { animation: g-rise .5s ease-out 2.45s both; }

/* B5: the water runs on, down to the village */
.g-stream { position: absolute; left: 235rpx; width: 280rpx; top: calc(11vh + 700rpx); bottom: 200rpx; background-size: 100% 100%; background-repeat: no-repeat; pointer-events: none; opacity: .9; }
.p-receding .g-stream, .p-chat .g-stream, .p-leaving .g-stream, .is-short .g-stream, .is-skipped .g-stream { display: none; }
.p-cinema .g-stream { animation: g-stream .95s cubic-bezier(.4, 0, .4, 1) 2.4s both; }
.p-reveal .g-stream { animation: g-stage-out .42s ease both; }
@keyframes g-stream { 0% { opacity: 0; -webkit-clip-path: inset(0 0 100% 0); clip-path: inset(0 0 100% 0); } 15% { opacity: .9; } 100% { opacity: .9; -webkit-clip-path: inset(0 0 0 0); clip-path: inset(0 0 0 0); } }

.g-skip { position: absolute; right: 24rpx; top: 22rpx; height: 76rpx; min-width: 132rpx; padding: 0 26rpx; box-sizing: border-box; border: 1rpx solid #d6ccb0; border-radius: 40rpx; background: rgba(255, 252, 245, .8); display: flex; align-items: center; justify-content: center; font-size: 23rpx; letter-spacing: 4rpx; color: #6d7a6c; z-index: 6; animation: g-fade .3s ease .3s both; }
.g-skip-arrow { margin-left: 6rpx; font-size: 30rpx; line-height: 1; color: #ad8849; }
@keyframes g-fade { 0% { opacity: 0; } 100% { opacity: 1; } }
@keyframes g-rise { 0% { opacity: 0; transform: translateY(26rpx); } 100% { opacity: 1; transform: translateY(0); } }

/* ---------- Phase C: the chat unrolls ---------- */
.g-chat { position: absolute; left: 0; top: 0; right: 0; bottom: 0; display: flex; flex-direction: column; box-sizing: border-box; z-index: 2; }
.g-head { position: relative; height: 124rpx; flex: none; }
.g-back { position: absolute; left: 12rpx; top: 10rpx; width: 96rpx; height: 96rpx; display: flex; align-items: center; justify-content: center; }
.g-back-arrow { font-family: "STKaiti", "KaiTi", serif; font-size: 62rpx; line-height: 1; color: #243f3b; margin-top: -8rpx; }
.g-head-text { position: absolute; left: 118rpx; top: 84rpx; }
.g-head-sub { font-size: 19rpx; letter-spacing: 2rpx; color: #8c927f; }
.g-mode { position: absolute; right: 28rpx; top: 32rpx; height: 52rpx; padding: 0 20rpx; box-sizing: border-box; display: flex; align-items: center; border: 1rpx solid #d7d8c8; border-radius: 30rpx; font-size: 20rpx; color: #7d8779; background: rgba(255, 252, 245, .7); }
.g-mode-dot { width: 10rpx; height: 10rpx; border-radius: 50%; background: #b9b8a6; margin-right: 10rpx; }
.g-mode-live { color: #243f3b; border-color: #b9c4b3; }
.g-mode-live .g-mode-dot { background: #5d8f6b; }
.g-rule { flex: none; height: 2rpx; margin: 0 28rpx; background: linear-gradient(90deg, rgba(173, 136, 73, 0), #c9ae78 16%, #8fa598 84%, rgba(143, 165, 152, 0)); }
.g-context { flex: none; display: flex; align-items: center; min-height: 68rpx; margin: 0 28rpx; padding: 6rpx 4rpx; border-bottom: 1rpx solid #ece8da; }
.g-context-label { font-size: 19rpx; letter-spacing: 3rpx; color: #929a88; }
.g-context-name { flex: 1; min-width: 0; margin-left: 14rpx; font-family: "STKaiti", "KaiTi", serif; font-size: 27rpx; letter-spacing: 2rpx; color: #243f3b; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.g-context-ask { flex: none; min-height: 56rpx; padding: 0 22rpx; display: flex; align-items: center; border: 1rpx solid #d9c9a5; border-radius: 30rpx; font-size: 21rpx; color: #8a6f3c; background: rgba(255, 252, 245, .8); }
.p-reveal .g-context { animation: g-fade .45s ease .3s both; }
.g-scroll { flex: 1; height: 0; min-height: 0; width: 100%; box-sizing: border-box; }
.p-reveal .g-back, .p-reveal .g-head-text, .p-reveal .g-mode { animation: g-fade .45s ease .3s both; }
.p-reveal .g-rule { animation: g-rule .6s cubic-bezier(.3, .7, .2, 1) .1s both; }
.p-reveal .g-w { animation: g-rise .5s cubic-bezier(.2, .7, .2, 1) both; }
.p-reveal .g-w-1 { animation-delay: .2s; } .p-reveal .g-w-2 { animation-delay: .28s; } .p-reveal .g-w-3 { animation-delay: .36s; } .p-reveal .g-w-4 { animation-delay: .4s; }
.p-reveal .g-msg { animation: g-rise .5s ease .3s both; }
.p-reveal .g-dock { animation: g-dock .5s cubic-bezier(.2, .8, .2, 1) .36s both; }
@keyframes g-rule { 0% { opacity: 0; transform: scaleX(0); } 100% { opacity: 1; transform: scaleX(1); } }
@keyframes g-dock { 0% { opacity: 0; transform: translateY(100%); } 100% { opacity: 1; transform: translateY(0); } }

/* ---------- Return to the page ---------- */
.p-leaving { animation: g-layer-out .52s ease both; pointer-events: none; }
.p-leaving .g-chat { animation: g-chat-out .46s ease both; }
@keyframes g-layer-out { 0% { opacity: 1; } 100% { opacity: 0; } }
@keyframes g-chat-out { 0% { transform: translateY(0); } 100% { transform: translateY(36rpx); } }

/* ---------- Welcome ---------- */
.g-welcome { padding: 28rpx 28rpx 0; }
.g-hello { display: flex; background: #fffcf5; border: 1rpx solid #e4e1d5; border-left: 5rpx solid #ad8849; border-radius: 6rpx 26rpx 26rpx 26rpx; padding: 28rpx 28rpx 26rpx; box-shadow: 0 10rpx 28rpx rgba(36, 63, 59, .05); }
.g-avatar { flex: none; width: 52rpx; height: 52rpx; border-radius: 50%; background: radial-gradient(circle at 34% 28%, #3c5d56, #243f3b 62%); border: 2rpx solid #c9ae78; box-sizing: border-box; display: flex; align-items: center; justify-content: center; }
.g-avatar-glyph { font-family: "STKaiti", "KaiTi", serif; font-size: 28rpx; line-height: 1; color: #fff8e6; }
.g-avatar-lg { width: 88rpx; height: 88rpx; margin-right: 22rpx; box-shadow: 0 0 0 5rpx rgba(173, 136, 73, .14); }
.g-avatar-lg .g-avatar-glyph { font-size: 48rpx; }
.g-hello-copy { flex: 1; min-width: 0; }
.g-hello-name { font-family: "STKaiti", "KaiTi", serif; font-size: 38rpx; line-height: 1.3; letter-spacing: 3rpx; }
.g-hello-role { font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif; font-size: 19rpx; letter-spacing: 1rpx; color: #9c7b42; margin-left: 16rpx; border: 1rpx solid #d9c9a5; border-radius: 6rpx; padding: 2rpx 10rpx; }
.g-hello-text { display: block; margin-top: 12rpx; font-size: 27rpx; line-height: 1.85; color: #4b5f58; }
.g-label { display: flex; align-items: baseline; justify-content: space-between; margin: 36rpx 2rpx 16rpx; font-size: 22rpx; letter-spacing: 4rpx; color: #7d8779; }
.g-label-note { font-size: 18rpx; letter-spacing: 1rpx; color: #a39a80; }
.g-stamps { display: flex; margin: 0 -4rpx; padding-top: 8rpx; }
.g-stamp { flex: 1; min-width: 0; margin: 0 14rpx; position: relative; text-align: center; }
.g-stamp-photo { position: relative; width: 100%; padding-top: 100%; border-radius: 12rpx; overflow: hidden; background: #dfe3d6; box-shadow: 0 0 0 1rpx #e4e1d5, 0 0 0 7rpx #fffcf5, 0 0 0 8rpx #d9c9a5; }
.g-stamp-img { position: absolute; left: 0; top: 0; width: 100%; height: 100%; display: block; }
.g-stamp-no { position: absolute; left: 8rpx; top: 8rpx; width: 40rpx; height: 40rpx; line-height: 40rpx; border-radius: 6rpx; background: rgba(36, 63, 59, .78); color: #f3e7c9; font-family: "STKaiti", "KaiTi", serif; font-size: 22rpx; }
.g-stamp-name { display: block; margin: 20rpx -10rpx 0; font-family: "STKaiti", "KaiTi", serif; font-size: 23rpx; letter-spacing: 0; line-height: 1.3; white-space: nowrap; }
.g-ask { display: flex; align-items: center; min-height: 92rpx; padding: 18rpx 22rpx; box-sizing: border-box; background: #fffcf5; border: 1rpx solid #e4e1d5; border-radius: 14rpx; margin-bottom: 14rpx; }
.g-ask-no { flex: none; width: 50rpx; font-family: "STKaiti", "KaiTi", serif; font-size: 28rpx; color: #ad8849; }
.g-ask-text { flex: 1; min-width: 0; font-size: 27rpx; line-height: 1.5; }
.g-ask-tag { flex: none; margin-left: 12rpx; font-size: 18rpx; color: #9c7b42; border: 1rpx solid #d9c9a5; border-radius: 6rpx; padding: 2rpx 10rpx; }
.g-ask-arrow { flex: none; margin-left: 14rpx; color: #b79a62; font-size: 24rpx; }
.g-ask-creative { border-style: dashed; border-color: #d9c9a5; background: #fbf7ec; }
.g-ground { margin: 22rpx 16rpx 0; text-align: center; font-size: 19rpx; line-height: 1.8; color: #929a88; }

/* ---------- Conversation ---------- */
.g-msg { padding: 0 28rpx; margin-top: 36rpx; animation: g-rise .36s ease both; }
.g-user { display: flex; justify-content: flex-end; }
.g-user-text { display: block; max-width: 560rpx; padding: 20rpx 28rpx; background: #243f3b; color: #fbf6e9; border-radius: 28rpx 28rpx 6rpx 28rpx; font-size: 28rpx; line-height: 1.7; white-space: pre-wrap; word-break: break-all; box-shadow: 0 8rpx 20rpx rgba(36, 63, 59, .14); }
.g-guide-head { display: flex; align-items: center; margin-bottom: 14rpx; }
.g-guide-name { margin-left: 14rpx; font-family: "STKaiti", "KaiTi", serif; font-size: 28rpx; letter-spacing: 2rpx; }
.g-guide-state { margin-left: 16rpx; font-size: 20rpx; color: #9c7b42; letter-spacing: 2rpx; }
.g-creative { margin-left: 16rpx; font-size: 18rpx; color: #9c7b42; border: 1rpx dashed #c9ae78; border-radius: 6rpx; padding: 2rpx 12rpx; background: #fbf7ec; }
.g-letter { position: relative; background: #fffcf5; border: 1rpx solid #e4e1d5; border-left: 5rpx solid #ad8849; border-radius: 6rpx 24rpx 24rpx 24rpx; padding: 26rpx 28rpx 22rpx 30rpx; box-shadow: 0 8rpx 24rpx rgba(36, 63, 59, .04); }
.g-letter-creative { background: #fbf7ec; border-left-style: dashed; }
.g-letter-creative .g-para { font-family: "STKaiti", "KaiTi", serif; font-size: 31rpx; letter-spacing: 1rpx; }
.g-para { font-size: 28rpx; line-height: 1.9; color: #2f4743; margin-bottom: 14rpx; word-break: break-all; }
.g-cite { font-size: 20rpx; color: #a07f45; letter-spacing: 0; }
.g-caret { width: 14rpx; height: 14rpx; border-radius: 50%; background: #ad8849; margin: 4rpx 0 10rpx; animation: g-caret 1s ease-in-out infinite; }
@keyframes g-caret { 0%, 100% { opacity: .25; transform: scale(.7); } 50% { opacity: 1; transform: scale(1); } }
.g-letter-wait { display: flex; align-items: center; width: 190rpx; height: 84rpx; padding: 0 30rpx; }
.g-drop { width: 14rpx; height: 14rpx; border-radius: 50% 50% 50% 50% / 62% 62% 38% 38%; background: #56756c; margin-right: 16rpx; animation: g-drop 1.25s ease-in-out infinite; }
.g-drop-2 { animation-delay: .18s; } .g-drop-3 { animation-delay: .36s; }
@keyframes g-drop { 0%, 100% { opacity: .2; transform: translateY(-8rpx) scale(.7); } 45% { opacity: 1; transform: translateY(6rpx) scale(1.05); } 70% { opacity: .5; transform: translateY(8rpx) scale(1.3, .6); } }
.g-sources { display: flex; flex-wrap: wrap; align-items: center; margin-top: 8rpx; padding-top: 16rpx; border-top: 1rpx solid #ece8da; }
.g-sources-label { font-size: 19rpx; letter-spacing: 3rpx; color: #929a88; margin-right: 12rpx; }
.g-source { font-size: 20rpx; line-height: 1.5; color: #8a6f3c; background: #faf5e8; border: 1rpx solid #dfd0ae; border-radius: 6rpx; padding: 8rpx 14rpx; margin: 6rpx 10rpx 6rpx 0; }
.g-origin { margin-top: 14rpx; font-size: 18rpx; letter-spacing: 1rpx; color: #9aa193; }
.g-note { margin-top: 14rpx; font-size: 21rpx; color: #7d8779; display: flex; align-items: center; }
.g-note-action { margin-left: 18rpx; padding: 12rpx 6rpx; color: #9c7b42; border-bottom: 1rpx solid #c9ae78; }
.g-error { margin-top: 4rpx; background: #fbf7ec; border: 1rpx dashed #c9ae78; border-radius: 16rpx; padding: 26rpx 28rpx; }
.g-error-title { font-family: "STKaiti", "KaiTi", serif; font-size: 31rpx; letter-spacing: 2rpx; }
.g-error-detail { margin-top: 8rpx; font-size: 23rpx; line-height: 1.75; color: #5f6f66; }
.g-error-code { color: #9aa193; font-size: 20rpx; }
.g-error-actions { display: flex; flex-wrap: wrap; margin-top: 20rpx; }
.g-btn { display: flex; align-items: center; justify-content: center; min-height: 72rpx; padding: 0 30rpx; box-sizing: border-box; border: 1rpx solid #b18d50; border-radius: 8rpx; font-size: 24rpx; color: #243f3b; background: #fffcf5; margin: 0 16rpx 10rpx 0; }
.g-btn-solid { background: #243f3b; border-color: #243f3b; color: #fffcf5; }
.g-card { display: flex; margin-top: 16rpx; background: #fffcf5; border: 1rpx solid #e4e1d5; border-radius: 16rpx; overflow: hidden; }
.g-card-photo { flex: none; width: 196rpx; height: 164rpx; display: block; background: #dfe3d6; }
.g-card-copy { flex: 1; min-width: 0; padding: 16rpx 20rpx 10rpx; }
.g-card-kicker { display: block; font-size: 18rpx; letter-spacing: 2rpx; color: #a48752; }
.g-card-name { display: block; font-family: "STKaiti", "KaiTi", serif; font-size: 32rpx; line-height: 1.4; letter-spacing: 2rpx; }
.g-card-links { display: flex; flex-wrap: wrap; margin-top: 4rpx; }
.g-link { font-size: 22rpx; color: #8a6f3c; padding: 14rpx 0; margin-right: 26rpx; border-bottom: 1rpx solid #d9c9a5; line-height: 1.2; }
.g-follow { display: flex; flex-direction: column; align-items: flex-start; margin-top: 18rpx; }
.g-follow-item { display: flex; align-items: center; min-height: 68rpx; padding: 12rpx 26rpx 12rpx 20rpx; box-sizing: border-box; margin-bottom: 12rpx; border: 1rpx solid #d9d8c8; border-radius: 8rpx 36rpx 36rpx 36rpx; background: rgba(255, 252, 245, .78); font-size: 25rpx; line-height: 1.5; color: #3d5650; }
.g-follow-mark { color: #ad8849; margin-right: 12rpx; }
.g-end { height: 48rpx; }

/* ---------- Input dock ---------- */
.g-dock { position: relative; flex: none; background: #fffcf5; border-top: 1rpx solid #e5e2d6; padding: 18rpx 24rpx calc(12rpx + env(safe-area-inset-bottom)); box-shadow: 0 -8rpx 28rpx rgba(36, 63, 59, .05); }
.g-dock-kb { padding-bottom: 12rpx; }
.g-dock-row { display: flex; align-items: flex-end; }
.g-field { flex: 1; min-width: 0; background: #f2efe6; border: 1rpx solid #ebe7da; border-radius: 26rpx; padding: 20rpx 26rpx; box-sizing: border-box; transition: border-color .2s ease, background .2s ease; }
.g-field-on { border-color: #c9ae78; background: #f7f3e8; }
.g-input { display: block; width: 100%; min-height: 44rpx; max-height: 176rpx; font-size: 28rpx; line-height: 44rpx; color: #243f3b; }
.g-placeholder { color: #a3a894; }
.g-send { flex: none; width: 88rpx; height: 88rpx; margin-left: 18rpx; border-radius: 50%; display: flex; align-items: center; justify-content: center; background: #e6e4d8; box-sizing: border-box; transition: background .2s ease, transform .2s ease; }
.g-send-glyph { font-family: "STKaiti", "KaiTi", serif; font-size: 40rpx; line-height: 1; color: #a3a894; }
.g-send-on { background: radial-gradient(circle at 34% 28%, #3c5d56, #243f3b 62%); box-shadow: 0 0 0 2rpx #c9ae78 inset, 0 8rpx 18rpx rgba(36, 63, 59, .22); }
.g-send-on .g-send-glyph { color: #fff8e6; }
.g-send-stop { background: #fffcf5; border: 2rpx solid #243f3b; }
.g-stop-icon { width: 26rpx; height: 26rpx; border-radius: 5rpx; background: #243f3b; }
.g-dock-foot { display: flex; justify-content: space-between; margin-top: 10rpx; padding: 0 8rpx; font-size: 17rpx; color: #a3a894; }
.g-hint { position: absolute; left: 24rpx; right: 24rpx; top: -78rpx; padding: 14rpx 24rpx; border-radius: 12rpx; background: rgba(36, 63, 59, .92); color: #f6f0df; font-size: 22rpx; line-height: 1.5; text-align: center; animation: g-rise .25s ease both; }
.g-jump { position: absolute; right: 28rpx; top: -84rpx; height: 60rpx; padding: 0 24rpx; display: flex; align-items: center; border-radius: 30rpx; background: #fffcf5; border: 1rpx solid #d9c9a5; color: #8a6f3c; font-size: 21rpx; box-shadow: 0 8rpx 20rpx rgba(36, 63, 59, .1); }

/* ---------- Source sheet ---------- */
.g-sheet-mask { position: absolute; left: 0; top: 0; right: 0; bottom: 0; z-index: 8; background: rgba(25, 44, 39, .42); display: flex; align-items: flex-end; animation: g-fade .2s ease both; }
.g-sheet { width: 100%; box-sizing: border-box; background: #f5f1e8; border-radius: 28rpx 28rpx 0 0; padding: 40rpx 36rpx calc(32rpx + env(safe-area-inset-bottom)); animation: g-rise .3s ease both; }
.g-sheet-kicker { font-size: 19rpx; letter-spacing: 3rpx; color: #a48752; }
.g-sheet-title { margin-top: 12rpx; font-family: "STKaiti", "KaiTi", serif; font-size: 36rpx; line-height: 1.5; letter-spacing: 2rpx; }
.g-sheet-meta { margin-top: 10rpx; font-size: 22rpx; color: #7d8779; }
.g-sheet-use { margin-top: 20rpx; font-size: 25rpx; line-height: 1.8; color: #4b5f58; }
.g-sheet-note { margin-top: 14rpx; font-size: 19rpx; line-height: 1.7; color: #929a88; }
.g-sheet-close { margin: 28rpx 0 0; min-height: 84rpx; }
