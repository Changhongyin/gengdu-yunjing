/* Custom tab bar: four destinations plus the raised center guide action. */
.tb { position: fixed; left: 0; right: 0; bottom: 0; z-index: 800; background: #fffcf5; border-top: 1rpx solid #e5e2d6; padding-bottom: env(safe-area-inset-bottom); box-shadow: 0 -8rpx 28rpx rgba(36, 63, 59, .05); transition: transform .5s cubic-bezier(.4, 0, .2, 1), opacity .4s ease; }
.tb-sunk { transform: translateY(60rpx); opacity: 0; pointer-events: none; }
.tb-row { display: flex; align-items: stretch; height: 112rpx; }
.tb-item { flex: 1; min-width: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; color: #7d8779; position: relative; }
.tb-text { font-size: 26rpx; line-height: 1.3; letter-spacing: 1rpx; }
.tb-dot { width: 8rpx; height: 8rpx; border-radius: 50%; background: #ad8849; margin-top: 8rpx; opacity: 0; transform: scale(.4); transition: opacity .25s ease, transform .25s ease; }
.tb-item.on { color: #243f3b; }
.tb-item.on .tb-text { font-weight: 600; }
.tb-item.on .tb-dot { opacity: 1; transform: scale(1); }
.tb-press { opacity: .6; }

/* Center action: a seal-like orb that rises out of the bar. */
.tb-center { flex: 1; min-width: 0; display: flex; flex-direction: column; align-items: center; justify-content: flex-end; position: relative; padding-bottom: 12rpx; }
.tb-orb { position: absolute; left: 50%; top: -44rpx; width: 116rpx; height: 116rpx; margin-left: -58rpx; border-radius: 50%; background: radial-gradient(circle at 34% 28%, #3c5d56 0%, #243f3b 58%, #1b322e 100%); border: 8rpx solid #fffcf5; box-shadow: 0 10rpx 26rpx rgba(36, 63, 59, .28), 0 -2rpx 0 #e5e2d6; display: flex; align-items: center; justify-content: center; transition: transform .18s ease; box-sizing: border-box; }
.tb-ring { position: absolute; left: 7rpx; top: 7rpx; right: 7rpx; bottom: 7rpx; border-radius: 50%; border: 2rpx solid rgba(214, 186, 132, .85); }
.tb-halo { position: absolute; left: -8rpx; top: -8rpx; right: -8rpx; bottom: -8rpx; border-radius: 50%; border: 2rpx solid #ad8849; opacity: 0; animation: tb-breathe 4.2s ease-out infinite; }
.tb-glyph { position: relative; font-family: "STKaiti", "KaiTi", serif; font-size: 54rpx; line-height: 1; color: #fff8e6; margin-top: -2rpx; }
.tb-leaf { position: absolute; right: 16rpx; top: 16rpx; width: 18rpx; height: 10rpx; border-radius: 100% 0 100% 0; background: #d6ba84; transform: rotate(-28deg); }
.tb-center-text { font-family: "STKaiti", "KaiTi", serif; font-size: 22rpx; letter-spacing: 3rpx; color: #9c7b42; line-height: 1.2; }
.tb-center-press .tb-orb { transform: scale(.93); }
@keyframes tb-breathe { 0% { opacity: 0; transform: scale(.94); } 18% { opacity: .55; } 60% { opacity: 0; transform: scale(1.22); } 100% { opacity: 0; transform: scale(1.22); } }
