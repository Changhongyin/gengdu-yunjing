<view class="page with-bottom fade-in"><view class="eyebrow">古渊头村 / 乡味好物</view><view class="title">把乡味带回家</view><view class="subtitle">所选好物与取货安排，都在这里。</view>
 <block wx:if="{{items.length}}"><view class="panel"><view class="small">古渊头村 · 四本堂</view><view wx:for="{{items}}" wx:key="key" class="order-item"><view class="order-art"><image wx:if="{{item.image}}" class="order-photo" src="{{item.image}}" mode="aspectFit" aria-label="{{item.name}}"/><view wx:else class="tiny muted">{{item.name}}</view></view><view class="grow"><view class="serif item-name">{{item.name}}</view><view class="tiny muted">{{item.spec}}</view><view class="row item-bottom"><text class="gold">¥{{item.price}} × {{item.quantity}}</text><button wx:if="{{!direct}}" class="remove" data-key="{{item.key}}" bindtap="remove">移除</button></view></view></view></view>
 <view class="panel"><view class="row"><text>收货与取货</text><text class="tiny gold">{{delivery === 'pickup' ? '到村自提 · 免运费' : '快递到家 · 运费 ¥6'}}</text></view><view class="chips delivery-chips"><button class="chip {{delivery === 'pickup' ? 'active' : ''}}" data-mode="pickup" bindtap="setDelivery">到村自提</button><button class="chip {{delivery === 'shipping' ? 'active' : ''}}" data-mode="shipping" bindtap="setDelivery">快递到家</button></view>
 <block wx:if="{{delivery === 'pickup'}}"><view class="small">古渊头村 · 四本堂</view><picker range="{{slots}}" value="{{slotIndex}}" bindchange="setSlot"><view class="field row pickup-field"><text>{{slots[slotIndex]}}</text><text>修改 ›</text></view></picker></block>
 <view wx:else class="address-fields"><input class="field" placeholder="收货人姓名" value="{{address.name}}" data-field="name" bindinput="addressInput"/><input class="field" placeholder="手机号码" type="number" maxlength="11" value="{{address.phone}}" data-field="phone" bindinput="addressInput"/><input class="field" placeholder="填写省市区、街道及门牌号" value="{{address.street}}" data-field="street" bindinput="addressInput"/></view></view>
 <view class="panel"><view class="row bill-row"><text class="muted">商品金额</text><text>¥{{subtotal}}</text></view><view class="row bill-row"><text class="muted">运费</text><text>¥{{shippingFee}}</text></view><view class="divider"/><view class="row"><text>应付合计</text><text class="price"><text class="currency">¥</text>{{total}}</text></view></view><view class="footnote">演示结算 · 不会发起付款或向商家发送订单</view><view class="fixed-bottom row"><view><view class="tiny muted">应付合计</view><view class="price"><text class="currency">¥</text>{{total}}</view></view><button class="primary checkout-button" bindtap="submit">生成演示订单</button></view></block>
 <view wx:else class="empty"><view class="empty-symbol">♧</view><view>还没有选好的乡味</view><button class="outline empty-button" bindtap="shop">去逛乡味好物</button></view>
</view>
