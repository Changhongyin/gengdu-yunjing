.postcard{padding:22rpx;margin-top:32rpx;box-shadow:0 8rpx 28rpx rgba(36,63,59,.06)}.postcard-art{position:relative;border-radius:8rpx;overflow:hidden;min-height:270rpx;background:#edeede}.postcard-art image{width:100%;display:block}.postcard-stamp{position:absolute;bottom:20rpx;right:20rpx;color:#af8b4c;background:#fffcf5;border:2rpx solid #ad8849;transform:rotate(9deg);border-radius:6rpx;padding:2rpx 12rpx;font-size:34rpx}.postcard-code{font-size:17rpx;letter-spacing:2rpx;color:#b08d50;margin-top:24rpx}.postcard-title{font-size:35rpx;margin-top:12rpx}.postcard-poem{margin-top:14rpx;line-height:1.8}
