.shop-page{padding-bottom:175rpx}.leaf{font-size:54rpx}.shopping-note{margin-top:20rpx;font-size:19rpx}.product-card{padding:12rpx 14rpx 20rpx;margin-top:22rpx;overflow:hidden}.product-title-row{margin:16rpx 6rpx 6rpx;gap:10rpx}.product-name{font-size:29rpx}.product-card .price{font-size:38rpx;white-space:nowrap}.product-card .small,.product-card .tiny{margin-left:6rpx}.product-card .button-row{margin-top:8rpx;gap:20rpx}.cart-bar{position:fixed;left:24rpx;right:24rpx;bottom:20rpx;border:1rpx solid #e2dfd2;box-shadow:0 5rpx 20rpx rgba(36,63,59,.08);padding:16rpx 22rpx;background:#fffcf5;border-radius:20rpx;z-index:5}.cart-bar .primary{width:45%}.cart-total{font-size:33rpx;line-height:1.3}.empty-button{margin:25rpx auto;max-width:300rpx}

/* Custom tab bar clearance: keep the cart bar and the last product above the bar. */
.shop-page{padding-bottom:calc(340rpx + env(safe-area-inset-bottom))}.cart-bar{bottom:calc(176rpx + env(safe-area-inset-bottom))}

/* Keep the existing serif product names and system search font. */
.product-searches{width:100%;margin:-4rpx 0 20rpx;white-space:nowrap}.search-terms{display:flex;align-items:center;gap:12rpx;padding:3rpx 0 8rpx}.search-label{flex-shrink:0;margin-right:2rpx}.search-term{flex-shrink:0;display:inline-block;padding:7rpx 16rpx;border:1rpx solid #dfdfd1;border-radius:28rpx;background:#fffcf5;color:#7d8779;font-size:20rpx;white-space:nowrap}.search-term-active{border-color:#b18d50;color:#ad8849;background:#f4eddd}.shop-page .chips{gap:10rpx}.shop-page .chip{flex:1;padding:12rpx 5rpx;white-space:nowrap}.product-name{flex:1;min-width:0}.product-card product-gallery{display:block;width:100%}
