<page-meta page-style="{{guideLock}}"/>
<view class="page shop-page fade-in {{guideMotion}}">
  <view class="eyebrow">古渊头村 / 把乡味与书香带回家</view><view class="row"><view class="title">乡味好物</view><text class="gold leaf">♧</text></view><view class="subtitle">一份古法手作，一缕耕读乡愁。</view>
  <view class="search"><text class="muted">⌕</text><input placeholder="搜博士菜、木雕、伞袋与杯具" value="{{query}}" bindinput="search" confirm-type="search"/><button wx:if="{{query}}" bindtap="clearSearch" aria-label="清空搜索">×</button></view>
  <scroll-view class="product-searches" scroll-x enable-flex show-scrollbar="{{false}}"><view class="search-terms"><text class="tiny muted search-label">寻一份好物</text><button wx:for="{{searchTerms}}" wx:key="*this" class="search-term {{query === item ? 'search-term-active' : ''}}" data-query="{{item}}" bindtap="quickSearch">{{item}}</button></view></scroll-view>
  <view class="chips"><button wx:for="{{categories}}" wx:key="*this" class="chip {{category === item ? 'active' : ''}}" data-category="{{item}}" bindtap="filter">{{item}}</button></view>
  <view class="small muted shopping-note">可收藏 · 可加购 · 带一份乡味回家</view>
  <view class="panel product-card" wx:for="{{products}}" wx:key="id">
    <product-gallery images="{{item.images}}" label="{{item.name}}" data-id="{{item.id}}" bind:select="openProduct"/>
    <view class="row product-title-row"><text class="serif product-name" data-id="{{item.id}}" bindtap="openProduct">{{item.name}}</text><text class="price"><text class="currency">¥</text>{{item.price}}</text></view>
    <view class="small muted">{{item.desc}}</view><view class="row"><text class="tiny gold">{{item.tag}}</text><button class="favorite {{item.favorite ? 'selected' : ''}}" data-id="{{item.id}}" bindtap="favorite" aria-label="收藏商品">{{item.favorite ? '♥' : '♡'}}</button></view>
    <view class="button-row"><button class="outline btn-small" bindtap="contact">联系商家</button><button class="primary btn-small" data-id="{{item.id}}" bindtap="addCart">加入购物车</button></view>
  </view>
  <view wx:if="{{!products.length}}" class="empty"><view class="empty-symbol">♧</view><view>{{query ? '没有找到相关好物' : '这一份乡味，还在准备中'}}</view><view class="small">试试其他分类，看看古村手作。</view><button class="outline btn-small empty-button" bindtap="resetFilter">查看全部好物</button></view>
  <view class="cart-bar row"><view bindtap="checkout"><view class="tiny muted">购物车 · {{cartCount}} 件</view><view class="cart-total">¥{{cartTotal}}</view></view><button class="primary btn-small" bindtap="checkout">查看购物车</button></view>
</view>
