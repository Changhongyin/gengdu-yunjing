.hero-art{margin:26rpx 0 20rpx;min-height:230rpx;display:flex;align-items:center}.hero-art product-gallery{display:block;width:100%}.product-heading{font-size:40rpx;line-height:1.5}.detail-copy{max-width:570rpx;margin-top:8rpx}.detail-price{margin:20rpx 0}.detail-price .price{white-space:nowrap}.unit{font-size:19rpx;color:#7d8779;margin-left:6rpx}.specs{display:flex;gap:12rpx;margin:18rpx 0 28rpx}.spec{flex:1;border:1rpx solid #deded1;border-radius:8rpx;padding:15rpx 10rpx;font-size:21rpx;text-align:left}.spec.chosen{border-color:#ad8849;background:#f4eddd}.quantity-row{border-top:1rpx solid #eeebdf;padding-top:22rpx}.stepper{display:flex;align-items:center;border:1rpx solid #deded1;border-radius:8rpx;background:#f4f1e8}.stepper button{width:60rpx;height:62rpx;font-size:32rpx}.stepper text{min-width:66rpx;text-align:center}.fulfillment{display:flex;background:#f2efe6;border-radius:8rpx;padding:4rpx;gap:8rpx}.fulfillment button{flex:1;padding:14rpx 5rpx;font-size:21rpx;color:#7d8779}.fulfillment .active{background:#243f3b;color:#fffcf5}.pickup-title{font-size:25rpx;margin-top:20rpx}.pickup-copy{margin:4rpx 0 20rpx 32rpx}.address-row{display:flex;gap:12rpx;margin-top:20rpx}.address-row .field{width:calc(50% - 6rpx)}.street{margin-top:14rpx}.subtotal{margin-top:22rpx}.subtotal .gold{font-size:34rpx;margin-left:10rpx}
