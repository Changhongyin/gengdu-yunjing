.panorama-page .title{font-size:48rpx}.pano-stage{height:720rpx;border-radius:20rpx;overflow:hidden;position:relative;margin-top:24rpx;background:#e7e8da}.illustration-area,.illustration-view,.pano-canvas{width:100%;height:100%}.pano-illustration{width:100%;height:100%;pointer-events:none}.scene-illustration{height:100%;display:flex;align-items:center;justify-content:center;background:#eeeddf}.scene-illustration scene-art{width:100%}.stage-top{position:absolute;top:20rpx;left:18rpx;right:18rpx;pointer-events:none}.stage-tag{font-size:19rpx;background:rgba(255,252,245,.88);padding:7rpx 12rpx;border-radius:8rpx}.stage-hint{position:absolute;bottom:24rpx;left:0;right:0;text-align:center;font-size:21rpx;color:#fffcf5;text-shadow:0 1rpx 7rpx #243f3b;pointer-events:none}.panorama-sources{margin-top:20rpx;gap:14rpx}.quality-note{margin:14rpx 0;line-height:1.6}.quality-info{margin-top:12rpx}.reset-button{padding:10rpx}.route-panel{padding:22rpx}.route-panel .icon-button{width:58rpx;height:58rpx;min-width:58rpx}.scene-tabs{display:flex;gap:10rpx;margin:22rpx 0}.scene-tab{width:calc(25% - 7.5rpx);padding:6rpx;background:#f2efe5;border:1rpx solid #dedfd0;border-radius:10rpx;position:relative}.scene-tab.active{border-color:#ad8849;background:#eee8d7}.scene-tab-art{height:85rpx;overflow:hidden}.scene-tab .tiny{font-size:16rpx;white-space:nowrap;display:block;margin-top:6rpx}.scene-tab.locked{opacity:.5}.tab-check{position:absolute;top:0;right:4rpx;color:#ad8849;background:#fffcf5;padding:0 4rpx;border-radius:4rpx;font-size:19rpx}.scene-controls{margin-top:24rpx;gap:20rpx}.scene-controls .outline{width:35%}.cards-link{text-align:center;margin:22rpx auto 0;color:#8f815d;font-size:22rpx}.task-story{margin:20rpx 0;line-height:1.9}.task-question{font-size:30rpx;margin:28rpx 0 20rpx}.answer{width:100%;text-align:left;padding:23rpx 20rpx;border:1rpx solid #cfd3c4;background:#fffcf5;margin:16rpx 0}.sheet .tiny{margin-top:20rpx}
.panorama-loading{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;flex-direction:column;gap:22rpx;background:#243f3b;color:#f5f1e8;font-size:23rpx;pointer-events:none}.loading-ring{width:50rpx;height:50rpx;border:3rpx solid rgba(255,255,255,.25);border-top-color:#d5b87e;border-radius:50%;animation:turn 1s linear infinite}@keyframes turn{to{transform:rotate(360deg)}}.panorama-toolbar{display:flex;align-items:center;gap:10rpx;margin-top:12rpx;background:#fffcf5;border:1rpx solid #d9ddce;border-radius:12rpx;padding:8rpx}.panorama-toolbar button{flex:1;min-width:0;width:auto!important;font-size:21rpx;padding:14rpx 8rpx}.panorama-toolbar button:nth-child(-n+2){flex:0 0 62rpx;font-size:30rpx}.panorama-toolbar .tour-control{color:#ad8849}.scene-view-toggle{display:flex;justify-content:flex-end;gap:24rpx;margin-top:10rpx}.scene-view-toggle button{width:auto!important;color:#7d8779;padding:8rpx 0}

.pano-canvas{position:relative;z-index:0}
