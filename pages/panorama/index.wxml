<page-meta page-style="{{guideLock}}"/>
<view class="page panorama-page fade-in {{guideMotion}}">
 <view class="eyebrow">线上寻樟 / 全景漫游</view><view class="row"><view class="title">{{scene.name}}</view><text class="gold small">0{{scene.id+1}} / 04</text></view>
 <view wx:if="{{imageStatus.failed}}" class="panel tiny muted">当前显示离线预览，图片暂未加载完整。<button class="text-button gold" bindtap="retryImages">重新加载图片</button></view>
 <view class="pano-stage">
  <movable-area wx:if="{{!localPhoto}}" class="illustration-area"><movable-view class="illustration-view" direction="all" scale scale-min="1" scale-max="3" scale-value="1" out-of-bounds><image class="pano-illustration" src="{{scene.panoramaImage}}" mode="aspectFill"/></movable-view></movable-area>
  <canvas wx:else type="webgl" id="panorama" hidden="{{showTask || guideMotion !== ''}}" class="pano-canvas" bindtouchstart="touchStart" catchtouchmove="touchMove" bindtouchend="touchEnd" bindtouchcancel="touchEnd"/>
  <view class="stage-top row"><text class="stage-tag">{{scene.chapter}} · {{scene.subtitle}}</text><text class="stage-tag">{{localPhoto ? '360° 实景' : collected ? '✓ 印记已收藏' : '待拾取印记'}}</text></view>
  <view wx:if="{{localPhoto && !panoramaReady}}" class="panorama-loading"><view class="loading-ring"/><text>正在展开古樟实景…</text></view>
  <view class="stage-hint">{{localPhoto ? '拖动环顾四周 · 双指缩放' : '双指缩放，左右拖动 · 实地摄影'}}</view>
 </view>
 <village-pet id="pet" covered="{{showTask}}" docked="{{true}}"/>
 <view wx:if="{{localPhoto}}" class="row quality-info"><text class="tiny gold">{{qualityText}}</text><button wx:if="{{scene.originalPanorama}}" class="tiny reset-button" bindtap="togglePhotoVersion">{{photoOrigin === 'original' ? '查看增强图' : '对比原片'}}</button></view>
 <view wx:if="{{localPhoto}}" class="panorama-toolbar"><button disabled="{{!panoramaReady}}" bindtap="zoomOut" aria-label="缩小">−</button><button disabled="{{!panoramaReady}}" bindtap="zoomIn" aria-label="放大">＋</button><button disabled="{{!panoramaReady}}" class="tour-control" bindtap="toggleTour">{{autoTour ? '暂停环游' : '自动环游'}}</button><button disabled="{{!panoramaReady}}" bindtap="resetView">重置视角</button></view>
 <view wx:if="{{scene.realPanorama}}" class="scene-view-toggle"><button class="tiny" bindtap="toggleSceneView">{{localPhoto ? '查看实景照片' : '进入 360° 实景'}}</button><button wx:if="{{panoramaFailed}}" class="tiny gold" bindtap="retryPanorama">重新加载实景</button></view>
 <view class="button-row panorama-sources"><button class="primary btn-small" bindtap="openReal">720云实景漫游 ↗</button><button class="outline btn-small" bindtap="importPhoto">导入高清全景</button></view>
 <view class="quality-note tiny muted">{{localPhoto ? photoOrigin === 'enhanced' ? '基于所提供的实景照片，使用 AI 清理标注并增强局部细节。' : photoOrigin === 'original' ? '当前显示原始照片，可与 AI 增强版本对比。' : '拖动探索全景，双指缩放查看细节。' : '本地可导入 2:1 球形全景照片；720云入口提供外部实景漫游。'}}</view>
 <view class="panel route-panel"><view class="row"><view><view>线上寻樟 · 关卡地图</view><view class="tiny muted">已集 {{count}} 张明信片 · 普通关卡任选</view></view><button class="icon-button" bindtap="map" aria-label="查看关卡地图"><image class="shortcut-icon" src="/assets/image_373.png" mode="aspectFit"/></button></view><view class="scene-tabs"><button wx:for="{{scenes}}" wx:key="id" class="scene-tab {{scene.id === item.id ? 'active' : ''}} {{item.locked ? 'locked' : ''}}" data-id="{{item.id}}" bindtap="switchScene"><view class="scene-tab-art"><scene-art style="display:block;width:100%;" kind="{{'scene' + item.id}}"/></view><text class="tiny">{{item.locked ? '待解锁' : item.name}}</text><text wx:if="{{item.collected}}" class="tab-check">✓</text></button></view><view class="tiny muted">{{finalUnlocked ? '终章已解锁，去寻找古村乡味。' : '终章任务：完成至少 2 个前置关卡解锁'}}</view></view>
 <view class="panel controls-panel"><view class="row"><text class="small">全景图切换</text><text class="tiny muted">四处风景</text></view><view class="row scene-controls"><button class="outline btn-small" disabled="{{scene.id === 0}}" bindtap="previous">‹ 上一关</button><text class="small gold">0{{scene.id+1}} / 04</text><button class="outline btn-small" disabled="{{scene.id === 3}}" bindtap="next">下一关 ›</button></view><view class="button-row"><button class="outline btn-small" bindtap="introduce"><image class="inline-icon" src="/assets/image_376.png" mode="aspectFit"/>了解这里</button><button class="primary btn-small" bindtap="task">{{collected ? '查看明信片' : '完成寻樟任务'}}</button></view><button class="cards-link" bindtap="cards">前往卡集 · {{count}} 张明信片 ›</button></view>
 <view class="footnote">一景一笺，慢慢走，慢慢收藏。</view>
 <view wx:if="{{showTask}}" class="sheet-mask" bindtap="closeTask"><view class="sheet" catchtap="noop"><view class="row"><text class="sheet-title">{{scene.subtitle}}</text><button class="close" bindtap="closeTask">×</button></view><view class="small muted task-story">{{scene.intro}}</view><view class="task-question">{{scene.question}}</view><button wx:for="{{scene.answers}}" wx:key="*this" class="answer" data-index="{{index}}" bindtap="answer">{{item}}</button><view class="tiny muted">读一段故事，拾一枚樟影。</view></view></view>
</view>
