.visit-page{padding-top:40rpx}.demo-badge{display:inline-block;color:#9c7d46;background:#eae5d7;font-size:19rpx;padding:8rpx 16rpx;margin-top:25rpx;border-radius:4rpx}.route-canvas{position:relative;margin-top:35rpx;padding:30rpx 18rpx 18rpx;background:#eeeee2;border-radius:10rpx;overflow:hidden}.route-caption{font-size:25rpx;color:#8a967f;letter-spacing:10rpx;margin:0 0 25rpx 18rpx}.route-line{position:absolute;left:45rpx;top:90rpx;bottom:90rpx;width:2rpx;background:#bdc4af}.route-stop{position:relative;display:flex;gap:17rpx;align-items:center;margin:0 0 22rpx 46rpx;padding:12rpx;background:#f9f7ef;border:1rpx solid #dedfce;border-radius:7rpx}.route-stop.selected{border-color:#ad8849;box-shadow:0 5rpx 20rpx rgba(36,63,59,.07)}.stop-marker{position:absolute;left:-38rpx;top:50%;margin-top:-15rpx;border:1rpx solid #b1ba9f;border-radius:50%;width:30rpx;height:30rpx;display:flex;align-items:center;justify-content:center;background:#eeeee2;color:#88957d;font-size:18rpx}.selected .stop-marker{background:#ad8849;color:#fff;border-color:#ad8849}.route-stop image{width:180rpx;height:140rpx;border-radius:4rpx}.stop-copy{flex:1;min-width:0}.stop-copy text{font-size:17rpx;color:#9a8a60}.stop-copy text:last-child{color:#949b88;font-size:16rpx}.stop-copy .serif{font-size:30rpx;margin:6rpx 0}.route-summary>.row>.serif{font-size:35rpx}.route-summary>.small{margin-top:14rpx;line-height:1.9}
