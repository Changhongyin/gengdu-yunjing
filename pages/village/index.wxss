.village-hero{position:relative;border-radius:18rpx;overflow:hidden;height:390rpx;margin-top:26rpx}.village-hero image{width:100%;height:100%}.hero-caption{position:absolute;bottom:22rpx;left:24rpx;background:rgba(255,252,245,.85);padding:7rpx 20rpx;font-size:29rpx}.village-name{font-size:32rpx}.village-intro .small{margin-top:14rpx}.tags{margin-top:18rpx}.scenic-card{display:flex;gap:22rpx;padding:18rpx;margin-top:18rpx;align-items:center}.scenic-art{width:220rpx;flex-shrink:0}.scenic-copy{flex:1;min-width:0}.scenic-name{font-size:32rpx;margin:4rpx 0}.scenic-intro{display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}.scenic-actions{margin-top:14rpx}.text-button{font-size:20rpx;padding:5rpx 0}.activity .serif{font-size:34rpx}.activity .small{margin:10rpx 0}.activity .tiny{margin-top:16rpx}

