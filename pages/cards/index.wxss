.collection-progress{margin-top:36rpx;font-size:23rpx}.collection-progress .gold{font-size:37rpx}.card-grid{display:flex;flex-wrap:wrap;gap:24rpx}.collection-card{width:calc(50% - 12rpx);text-align:left;background:#fffcf5;border:1rpx solid #e2e0d4;border-radius:16rpx;padding:10rpx 10rpx 20rpx;box-shadow:0 5rpx 14rpx rgba(36,63,59,.04)}.collected{border-color:#c3ccb9}.card-image{position:relative;border-radius:9rpx;overflow:hidden}.uncollected{filter:grayscale(.9);opacity:.55}.question-mark{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;font-size:52rpx;color:#7e8976;background:rgba(232,231,221,.45)}.stamp{position:absolute;bottom:10rpx;right:10rpx;border:1rpx solid #b08a47;color:#b08a47;background:#fffcf5;border-radius:5rpx;transform:rotate(9deg);font-size:26rpx;padding:0 7rpx}.card-meta{font-size:17rpx;color:#ad8849;margin:12rpx 4rpx 4rpx}.card-name{font-size:26rpx;margin:0 4rpx;white-space:nowrap}.card-status{font-size:17rpx;margin:9rpx 4rpx 0}.achievement{margin-top:32rpx;border:3rpx double #b59459;border-radius:16rpx;padding:24rpx;background:#eeebde}.achievement-title{font-size:34rpx;color:#ad8849}.achievement .small{margin-top:12rpx}.complete{background:#e5e9d8}
/* Override the default v2 button width so cards stay in two equal columns. */
.card-grid > .collection-card{display:block;box-sizing:border-box;flex:0 0 calc(50% - 12rpx);width:calc(50% - 12rpx)!important;min-width:0;max-width:calc(50% - 12rpx);margin:0!important}
.card-image{height:320rpx;background:#f5f1e8}.card-scene{display:block;width:100%;height:100%}.uncollected{filter:grayscale(.35);opacity:.82}.question-mark{background:rgba(232,231,221,.12);color:#fffcf5;text-shadow:0 1rpx 8rpx #243f3b}
