<page-meta page-style="{{guideLock}}"/>
<view class="page fade-in tab-safe {{guideMotion}}"><view class="eyebrow">古渊头村 / 我的耕读日常</view><view class="title">个人中心</view><view class="subtitle">把足迹与喜欢，轻轻收藏。</view><view class="panel profile-card"><image class="avatar" src="{{avatarSrc}}" mode="aspectFit" aria-label="寻樟旅人头像"/><view class="grow"><view class="nickname serif">{{nickname}}</view><view class="tiny gold">{{count === 4 ? '古村知音' : '樟下听书人'}}</view><view class="small muted">在古渊头，拾一页乡愁。</view></view><text class="vertical gold">樟影相伴</text></view>
 <view class="panel menu"><button class="menu-item row" bindtap="rename"><view class="menu-icon personal-icon"><image class="personal-base" src="/assets/image_338.png" mode="scaleToFill"/><view class="personal-head"/><image class="personal-body" src="/assets/image_339.png" mode="aspectFit"/></view><text>个人信息</text><text class="muted">›</text></button><button class="menu-item row" bindtap="cards"><image class="menu-icon" src="/assets/image_341.png" mode="aspectFit"/><view><view>寻樟明信片</view><view class="tiny muted">通关一景，收藏一笺</view></view><text class="gold">{{count}} / 4 ›</text></button><button class="menu-item row" bindtap="favorites"><image class="menu-icon" src="/assets/image_345.png" mode="aspectFit"/><view><view>我的收藏</view><view class="tiny muted">商品收藏</view></view><text class="muted">{{favoriteCount}} ›</text></button><button class="menu-item row" bindtap="orders"><image class="menu-icon" src="/assets/image_347.png" mode="aspectFit"/><view><view>购买记录</view><view class="tiny muted">订单与商品</view></view><text class="muted">{{orderCount}} ›</text></button><button class="menu-item row" bindtap="cart"><image class="menu-icon" src="/assets/image_349.png" mode="aspectFit"/><text>我的购物车</text><text class="muted">›</text></button><button class="menu-item row" bindtap="feedback"><image class="menu-icon" src="/assets/image_353.png" mode="aspectFit"/><text>反馈</text><text class="muted">›</text></button></view><view class="footnote"><image class="inline-icon" src="/assets/image_355.png" mode="aspectFit"/>樟影入心，书声相伴</view>
 <view wx:if="{{sheet}}" class="sheet-mask" bindtap="closeSheet"><view class="sheet" catchtap="noop"><view class="row"><text class="sheet-title">{{sheetTitle}}</text><button class="close" bindtap="closeSheet">×</button></view>
 <block wx:if="{{sheet === 'favorites'}}"><view wx:if="{{!favoriteProducts.length}}" class="empty">还没有收藏好物，去商城逛逛吧。</view><view wx:for="{{favoriteProducts}}" wx:key="id" class="panel row" data-id="{{item.id}}" bindtap="product"><text class="serif">{{item.name}}</text><text class="gold">¥{{item.price}} ›</text></view></block>
 <block wx:elif="{{sheet === 'orders'}}"><view wx:if="{{!orderList.length}}" class="empty">还没有购买记录。</view><view class="panel" wx:for="{{orderList}}" wx:key="id"><view class="row"><text class="tiny muted">{{item.id}}</text><text class="gold">¥{{item.total}}</text></view><view class="small order-line" wx:for="{{item.items}}" wx:for-item="good" wx:key="key">{{good.name}} × {{good.quantity}}</view><view class="tiny muted">{{item.delivery === 'pickup' ? '到村自提' : '快递到家'}} · {{item.date}}</view><view class="tiny gold">{{item.status}}</view></view></block>
 <block wx:elif="{{sheet === 'feedback'}}"><textarea class="field feedback" placeholder="写下你的想法，给古村留一封乡信。" maxlength="500" value="{{feedbackText}}" bindinput="feedbackInput"/><view class="tiny muted">反馈保存在此设备，尚未连接在线客服。</view><button class="primary" bindtap="saveFeedback">保存反馈</button></block>
 </view></view>
</view>
