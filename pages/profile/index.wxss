.profile-card{display:flex;align-items:center;gap:22rpx;margin-top:35rpx;padding:30rpx 24rpx}.avatar{width:112rpx;height:112rpx;display:flex;align-items:center;justify-content:center;font-size:54rpx;background:#e5e8d9;border:1rpx solid #c5cdb9;border-radius:50%;color:#7c8e71}.nickname{font-size:35rpx}.vertical{writing-mode:vertical-rl;letter-spacing:6rpx;font-family:serif;font-size:23rpx}.menu{padding:0 24rpx;margin-top:30rpx}.menu-item{width:100%;text-align:left;min-height:110rpx;border-bottom:1rpx solid #e6e3d7;border-radius:0;padding:20rpx 2rpx}.menu-item:last-child{border-bottom:0}.menu-item .tiny{margin-top:4rpx}.order-line{margin:12rpx 0}.feedback{height:250rpx;margin:20rpx 0}.sheet .primary{margin-top:28rpx}

.avatar{flex-shrink:0;overflow:hidden;background:transparent;border:0;}
.menu-item{justify-content:flex-start;gap:20rpx}.menu-item > text:last-child{margin-left:auto}.menu-icon{width:36rpx;height:36rpx;flex-shrink:0}.personal-icon{position:relative}.personal-head{position:absolute;width:16rpx;height:16rpx;left:10rpx;top:1rpx}.personal-body{position:absolute;width:30rpx;height:16rpx;left:3rpx;bottom:1rpx}

.menu .menu-item{width:100%!important;max-width:none;margin:0}.personal-base{position:absolute;inset:0;width:100%;height:100%}.personal-head{width:15rpx;height:15rpx;left:10rpx;top:6rpx;border:2rpx solid #243f3b}

/* Custom tab bar clearance: bottom sheets end at the top of the bar, as they did with the native bar. */
.sheet-mask{bottom:calc(112rpx + env(safe-area-inset-bottom))}
