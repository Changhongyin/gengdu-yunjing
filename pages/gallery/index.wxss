page{background:#172a25;color:#f4f0e5;overflow:hidden}.gallery-page{height:100vh;display:flex;flex-direction:column;overflow:hidden}.gallery-heading{flex-shrink:0;padding:25rpx 32rpx;font-size:24rpx;letter-spacing:2rpx;color:#dfdfcf}.gallery-count{font-size:21rpx;color:#c0ad7b;letter-spacing:4rpx}.gallery-swiper{flex:1;width:100%;min-height:0}.photo-area,.photo-view{width:100%;height:100%}.full-photo{display:block;width:100%;height:100%}.gallery-footer{flex-shrink:0;padding:23rpx 32rpx calc(24rpx + env(safe-area-inset-bottom));background:#1d332c}.photo-caption{font-size:24rpx;line-height:1.7;text-align:center;color:#e8e6d6}.zoom-hint{font-size:19rpx;color:#a8b7a4;text-align:center;margin:10rpx 0 22rpx}.gallery-toolbar{display:flex;align-items:center;justify-content:space-between;gap:12rpx}.gallery-toolbar button{width:75rpx;height:74rpx;display:flex;align-items:center;justify-content:center;border:1rpx solid #596b56;border-radius:8rpx;color:#e6e7d7;font-size:33rpx;margin:0;background:transparent}.gallery-toolbar button[disabled]{color:#526b5c;background:transparent;border-color:#334d3e}.gallery-toolbar .reset{flex:1;font-size:21rpx;color:#c8b886}.gallery-toolbar .step{border:0;font-size:48rpx}.original-label{font-size:17rpx;letter-spacing:3rpx;color:#839782;text-align:center;margin-top:18rpx}.loading-hint,.photo-failed{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;color:#b4bea7;font-size:23rpx;pointer-events:none}.photo-failed{flex-direction:column;gap:24rpx;pointer-events:auto}.photo-failed button{padding:12rpx 28rpx;border:1rpx solid #b6a36c;color:#d3c49d;font-size:23rpx}
